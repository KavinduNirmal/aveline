{
  "uid": "aveline-overview",
  "title": "Aveline \u2014 System overview",
  "description": "The system dashboard: scrape health, RED metrics, saturation, the event bus and the bridged business gauges. Every aveline_* series here is asserted against the API's MetricsCatalog by GrafanaProvisioningTests; a typo cannot ship silently.",
  "tags": [
    "aveline",
    "system",
    "operator"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aveline-prometheus"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "A"
        },
        "includeAll": false,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Business metrics",
      "type": "link",
      "url": "/d/aveline-business",
      "icon": "external link"
    },
    {
      "title": "Database",
      "type": "link",
      "url": "/d/aveline-database",
      "icon": "external link"
    },
    {
      "title": "Notifications",
      "type": "link",
      "url": "/d/aveline-notifications",
      "icon": "external link"
    },
    {
      "title": "Prometheus",
      "type": "link",
      "url": "http://localhost:9090",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
