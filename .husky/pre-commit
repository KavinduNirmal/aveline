#!/usr/bin/env sh
# =============================================================================
# Aveline — Husky Pre-commit Hook
#
# Runs quality gates before every commit. Checks are intentionally fast.
# If a check fails, the commit is blocked with a clear error message.
# =============================================================================

set -e

# ----- ANSI colour & style codes --------------------------------------------
BOLD='\033[1m'
DIM='\033[2m'
UNDERLINE='\033[4m'
NC='\033[0m'          # No Color
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'

# ----- Helper functions for TUI --------------------------------------------
print_header() {
    printf '\n'
    printf '%b' "${CYAN}${BOLD}"
    printf '╔══════════════════════════════════════════════════════════════╗\n'
    printf '║                                                              ║\n'
    printf '║       🔍  Aveline Pre‑commit Checks                          ║\n'
    printf '║                                                              ║\n'
    printf '╚══════════════════════════════════════════════════════════════╝'
    printf '%b\n' "${NC}"
    printf '\n'
}

print_separator() {
    printf '%b' "${DIM}"
    printf '────────────────────────────────────────────────────────────────\n'
    printf '%b' "${NC}"
}

print_check_start() {
    # $1 = step number, $2 = description
    printf '%b' "${BOLD}${WHITE}"
    printf '  [%s/6] %s\n' "$1" "$2"
    printf '%b' "${NC}"
}

print_check_pass() {
    printf '%b' "${GREEN}${BOLD}"
    printf '      ✅ %s\n' "$1"
    printf '%b' "${NC}"
}

print_check_fail() {
    printf '%b' "${RED}${BOLD}"
    printf '      ❌ %s\n' "$1"
    printf '%b' "${NC}"
}

print_check_warn() {
    printf '%b' "${YELLOW}${BOLD}"
    printf '      ⚠️  %s\n' "$1"
    printf '%b' "${NC}"
}

print_error_block() {
    # $1 = list of offending files
    printf '\n'
    printf '%b' "${RED}${BOLD}"
    printf '  ┌────────────────────────────────────────────────────────────┐\n'
    printf '  │  COMMIT BLOCKED                                           │\n'
    printf '  └────────────────────────────────────────────────────────────┘\n'
    printf '%b' "${NC}"
    printf '%b' "${RED}"
    printf '  %s\n' "$1"
    printf '%b' "${NC}"
    printf '\n'
}

# ----- Start of checks ------------------------------------------------------
print_header

# ---------------------------------------------------------------------------
# 1. GUARD: No .env files committed
# ---------------------------------------------------------------------------
print_check_start 1 "Checking for .env files in staged changes"
STAGED_ENV=$(git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.env\.example' || true)
if [ -n "$STAGED_ENV" ]; then
    print_error_block "You are trying to commit a .env file:"
    printf '%b' "${RED}"
    printf '    %s\n' "$STAGED_ENV"
    printf '%b' "${NC}"
    print_check_fail "Remove these files from staging with: git restore --staged <file>"
    exit 1
fi
print_check_pass "No .env files staged"
print_separator

# ---------------------------------------------------------------------------
# 2. GUARD: Only bun lockfiles allowed
# ---------------------------------------------------------------------------
print_check_start 2 "Checking for non‑bun lockfiles"
STAGED_NON_BUN_LOCKS=$(git diff --cached --name-only | grep -E '(package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.ya?ml)$' || true)
if [ -n "$STAGED_NON_BUN_LOCKS" ]; then
    print_error_block "Only bun lockfiles (bun.lock / bun.lockb) are allowed."
    printf '%b' "${RED}"
    printf '    Found non‑bun lockfile(s) staged for commit:\n'
    printf '    %s\n' "$STAGED_NON_BUN_LOCKS"
    printf '%b' "${NC}"
    print_check_fail "Please use bun and remove other lockfiles."
    exit 1
fi
print_check_pass "Only bun lockfiles staged"
print_separator

# ---------------------------------------------------------------------------
# 3. GUARD: No obvious secrets in staged files
# ---------------------------------------------------------------------------
print_check_start 3 "Scanning staged files for potential secrets"
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
SECRET_FOUND=""
# Secret-indicating key names (case-insensitive), matched anywhere in the key.
SECRET_KEY_RE='(password|passwd|secret|token|api[_-]?key|private[_-]?key|access[_-]?key|encryption[_-]?key|publishable[_-]?key|client[_-]?secret|auth[_-]?token|internal[_-]?token)'
# Placeholder values that are safe to commit in templates/examples.
PLACEHOLDER_RE='(change[_-]?me|your[_-]|example|placeholder|xxxx+|xxx+|sk_test_placeholder|pk_test_placeholder|<\w+>)'
for file in $STAGED_FILES; do
    case "$file" in
        *.png|*.jpg|*.gif|*.pdf|*.zip|*.lock|*.gitignore|.husky/*) continue ;;
    esac
    content=$(git show ":$file" 2>/dev/null)
    # Flag .env-style KEY=value (or quoted) lines whose key indicates a secret
    # and whose value is a real (non-placeholder) token. Covers .env.example too.
    if printf '%s' "$content" | grep -qiE "^[A-Z0-9_]*${SECRET_KEY_RE}[A-Z0-9_]*[[:space:]]*=[[:space:]]*[\"']?[^\"'[:space:]]{8,}" \
        && ! printf '%s' "$content" | grep -qiE "^[A-Z0-9_]*${SECRET_KEY_RE}[A-Z0-9_]*[[:space:]]*=[[:space:]]*[\"']?${PLACEHOLDER_RE}"; then
        SECRET_FOUND="$SECRET_FOUND $file"
    fi
done
if [ -n "$SECRET_FOUND" ]; then
    print_error_block "Potential secrets detected in:"
    printf '%b' "${RED}"
    printf '    %s\n' "$SECRET_FOUND"
    printf '%b' "${NC}"
    print_check_fail "Review these files. Use environment variables instead."
    print_check_fail "Real keys must never be committed — even in .env.example."
    print_check_fail "False positive? Use: git commit --no-verify"
    exit 1
fi
print_check_pass "No obvious secrets found"
print_separator

# ---------------------------------------------------------------------------
# 4. ASP.NET Core API — dotnet build
# ---------------------------------------------------------------------------
print_check_start 4 "Building ASP.NET Core API"
if command -v dotnet >/dev/null 2>&1; then
    if dotnet build Aveline.Api/Aveline.Api.csproj --no-restore -c Debug -v quiet 2>&1; then
        print_check_pass "dotnet build passed"
    else
        print_check_fail "dotnet build failed. Fix build errors before committing."
        exit 1
    fi
else
    print_check_warn "dotnet not found — skipping API build check"
fi
print_separator

# ---------------------------------------------------------------------------
# 5. Python — syntax check on staged .py files
# ---------------------------------------------------------------------------
print_check_start 5 "Checking Python syntax on staged .py files"
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "$STAGED_PY" ]; then
    if command -v python3 >/dev/null 2>&1; then
        PYTHON_ERRORS=""
        for pyfile in $STAGED_PY; do
            if ! python3 -m py_compile "$pyfile" 2>/dev/null; then
                PYTHON_ERRORS="$PYTHON_ERRORS $pyfile"
            fi
        done
        if [ -n "$PYTHON_ERRORS" ]; then
            print_error_block "Python syntax errors in:"
            printf '%b' "${RED}"
            printf '    %s\n' "$PYTHON_ERRORS"
            printf '%b' "${NC}"
            exit 1
        fi
        print_check_pass "Python syntax OK"
    else
        print_check_warn "python3 not found — skipping Python syntax check"
    fi
else
    print_check_pass "No .py files staged"
fi
print_separator

# ---------------------------------------------------------------------------
# 6. Flutter — analyze on staged .dart files
# ---------------------------------------------------------------------------
print_check_start 6 "Checking staged .dart files"
STAGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)
if [ -n "$STAGED_DART" ]; then
    if command -v flutter >/dev/null 2>&1; then
        if flutter analyze frontend/aveline_mobile --no-fatal-infos 2>&1 | grep -q 'No issues found'; then
            print_check_pass "Flutter analyze passed"
        else
            print_check_warn "Flutter analyze reported issues. Run 'flutter analyze' to review."
            print_check_warn "Commit is not blocked — but please fix warnings before merging to main."
        fi
    else
        print_check_warn "flutter not found — skipping Flutter analyze"
    fi
else
    print_check_pass "No .dart files staged"
fi

# ---------------------------------------------------------------------------
# All checks passed
# ---------------------------------------------------------------------------
printf '\n'
printf '%b' "${GREEN}${BOLD}"
printf '  ┌────────────────────────────────────────────────────────────┐\n'
printf '  │                                                            │\n'
printf '  │   ✅  All pre‑commit checks passed. Proceeding with commit │\n'
printf '  │                                                            │\n'
printf '  └────────────────────────────────────────────────────────────┘\n'
printf '%b\n' "${NC}"