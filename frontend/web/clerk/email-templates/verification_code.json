{
  "name": "Verification code",
  "subject": "{{otp_code}} is your {{app.name}} verification code",
  "markup": "<re-html>\n<re-head>\n    <re-title>\n        Your {{app.name}} verification code\n    </re-title>\n</re-head>\n<re-body background-color=\"#f5eceb\" padding=\"32px 16px 40px 16px\">\n    <re-preheader>\n        Your {{app.name}} verification code\n    </re-preheader>\n    <re-header padding=\"28px 32px 16px 32px\">\n        <re-text font-size=\"18px\" line-height=\"26px\" color=\"#8b2e42\" align=\"center\">\n            {{> app_logo}}\n        </re-text>\n    </re-header>\n    <re-main background-color=\"#ffffff\" border-radius=\"16px\">\n        <re-block align=\"center\" padding=\"48px 40px 44px 40px\" background-color=\"#ffffff\" border-radius=\"16px\">\n            <re-heading margin=\"0\" level=\"h1\" align=\"center\" color=\"#1e1b1b\" font-size=\"28px\" line-height=\"38px\" font-weight=\"500\">\n                Your verification code\n            </re-heading>\n            <re-text margin=\"12px 0px 0px 0px\" align=\"center\" font-size=\"12px\" font-weight=\"600\" color=\"#8b2e42\" line-height=\"18px\" padding=\"0px 0px 0px 0px\">\n                {{app.name}}\n            </re-text>\n            <re-text margin=\"32px 0px 0px 0px\" align=\"center\" font-size=\"16px\" color=\"#534244\" line-height=\"28px\" padding=\"0px 0px 0px 0px\">\n                Enter the code below when prompted to finish setting up your account.\n            </re-text>\n            <re-block align=\"center\" margin=\"32px 0px 0px 0px\" padding=\"12px 20px\" background-color=\"#fbf2f1\" border-radius=\"14px\">\n                <re-text align=\"center\" font-size=\"40px\" font-weight=\"700\" color=\"#8b2e42\" line-height=\"46px\">\n                    {{otp_code}}\n                </re-text>\n            </re-block>\n            <re-text margin=\"28px 0px 0px 0px\" align=\"center\" font-size=\"14px\" color=\"#867274\" line-height=\"24px\">\n                For your security, never share this code. Our team will never ask for it.\n            </re-text>\n            <re-block margin=\"36px 0px 0px 0px\" padding=\"0px 0px 0px 0px\">\n                <re-divider background-color=\"#e9e0e0\" height=\"1px\"></re-divider>\n            </re-block>\n            <re-text margin=\"24px 0px 0px 0px\" align=\"center\" font-size=\"13px\" color=\"#867274\" line-height=\"22px\">\n                Didn&rsquo;t request this? This code was requested from <b>{{requested_from}}</b> at <b>{{requested_at}}</b>. If that wasn&rsquo;t you, you can safely ignore this email.\n            </re-text>\n        </re-block>\n    </re-main>\n    <re-footer padding=\"24px 32px 0px 32px\">\n        <re-text align=\"center\" font-size=\"12px\" color=\"#867274\">{{> copyright}}</re-text>\n    </re-footer>\n</re-body>\n</re-html>",
  "body": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n    <title>Your {{app.name}} verification code</title>\n  </head>\n  <body style=\"margin:0;padding:0;background-color:#f5eceb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n    <center role=\"article\" aria-roledescription=\"email\" lang=\"en\" style=\"width:100%;background-color:#f5eceb;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f5eceb;\">\n        <tr>\n          <td align=\"center\" style=\"padding:48px 20px;\">\n            <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background-color:#ffffff;border-radius:16px;box-shadow:0 4px 20px rgba(139,46,66,0.06);\">\n              <tr>\n                <td align=\"center\" style=\"padding:48px 48px 0 48px;\">\n                  {{> app_logo}}\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:24px 48px 0 48px;\">\n                  <p style=\"margin:0;font-family:Georgia,'Times New Roman',serif;font-size:28px;line-height:1.35;font-weight:500;color:#1e1b1b;letter-spacing:-0.01em;\">\n                    Your verification code\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:12px 48px 0 48px;\">\n                  <p style=\"margin:0;font-size:12px;line-height:1.5;font-weight:600;color:#8b2e42;letter-spacing:0.14em;text-transform:uppercase;\">\n                    {{app.name}}\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:28px 56px 0 56px;\">\n                  <p style=\"margin:0;font-size:16px;line-height:1.8;color:#534244;\">\n                    Enter the code below when prompted to finish setting up your account.\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:28px 88px 0 88px;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td align=\"center\" style=\"background-color:#fbf2f1;border:1px solid #e9e0e0;border-radius:14px;padding:12px 16px;\">\n                        <p style=\"margin:0;font-family:'Courier New',Courier,monospace;font-size:38px;line-height:1.2;font-weight:700;color:#8b2e42;letter-spacing:0.16em;\">\n                          {{otp_code}}\n                        </p>\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:24px 56px 0 56px;\">\n                  <p style=\"margin:0;font-size:14px;line-height:1.7;color:#867274;\">\n                    For your security, never share this code with anyone. Our team will never ask for it.\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:36px 48px 0 48px;\">\n                  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td style=\"border-top:1px solid #e9e0e0;\"></td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:24px 48px 0 48px;\">\n                  <p style=\"margin:0;font-size:13px;line-height:1.7;color:#867274;\">\n                    Didn&rsquo;t request this? This code was requested from <strong style=\"color:#534244;\">{{requested_from}}</strong> at <strong style=\"color:#534244;\">{{requested_at}}</strong>. If that wasn&rsquo;t you, you can safely ignore this email.\n                  </p>\n                </td>\n              </tr>\n              <tr>\n                <td align=\"center\" style=\"padding:28px 48px 40px 48px;font-size:12px;line-height:1.6;color:#867274;\">\n                  {{> copyright}}\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </center>\n  </body>\n</html>"
}
