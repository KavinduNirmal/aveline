# =============================================================================
# Aveline Agent Service — Python / LangGraph configuration
# Copy to `.env` and fill in real values before running the service.
# =============================================================================

# --- Internal service-to-service auth (REQUIRED, fail-fast) ---
# Shared secret used to authenticate requests from Aveline.Api. The backend sends
# this in the "X-Internal-Token" header; requests without a valid token are
# rejected with 401. The service REFUSES TO START if this is empty or a known
# placeholder value. Override with a strong value in production.
INTERNAL_API_TOKEN=change-me-internal-token

# --- LLM provider (OpenAI or DeepSeek, switched at runtime) ---
# Which provider to use: "openai" or "deepseek".
LLM_PROVIDER=openai
# API key for the selected provider.
LLM_API_KEY=
# Optional base URL override (e.g. a gateway or DeepSeek's API). Leave empty to
# use the provider's default endpoint.
LLM_BASE_URL=
# Default model name (e.g. "gpt-4o" for OpenAI, "deepseek-v4-flash" for DeepSeek).
LLM_MODEL=

# --- Database (PostgreSQL + pgvector) ---
# Async SQLAlchemy connection string (local docker-compose defaults).
DATABASE_URL=postgresql+asyncpg://aveline:change-me@localhost:5432/aveline

# --- Redis Pub/Sub event bus (ADR-014) + caching ---
# Connection URL for the Redis instance used for pub/sub (and caching).
REDIS_URL=redis://localhost:6379/0
# Event types this service subscribes to (e.g. "message.received"). Empty until a
# consumer lands. Space-separated list.
SUBSCRIBE_EVENT_TYPES=

# --- Observability (OpenTelemetry) ---
# OTLP exporter endpoint (e.g. the docker-compose otel-collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Resource attribute identifying this service in traces.
# OTEL_SERVICE_NAME=aveline-agent-service
# Set to "false" in production to strip prompt/completion content from spans.
# OTEL_TRACE_CONTENT=true
