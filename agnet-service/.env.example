# =============================================================================
# Aveline Agent Service — Python / LangGraph configuration
# Copy to `.env` and fill in real values before running the service.
# =============================================================================

# Async SQLAlchemy connection string (local docker-compose defaults).
DATABASE_URL=postgresql+asyncpg://aveline:change-me@localhost:5432/aveline

# --- Internal service-to-service auth ---
# Shared secret used to authenticate requests from Aveline.Api. The backend sends
# this in the "X-Internal-Token" header; requests without a valid token are
# rejected with 401. Override with a strong value in production.
INTERNAL_API_TOKEN=change-me-internal-token

# --- LLM provider ---
# OpenAI API key used by langchain-openai for the agentic workflow.
# OPENAI_API_KEY=

# --- Observability (LangSmith) ---
# Optional: enable LangSmith tracing.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aveline
