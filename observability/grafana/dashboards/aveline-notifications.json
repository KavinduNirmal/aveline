{
  "uid": "aveline-notifications",
  "title": "Aveline \u2014 Notifications",
  "description": "The notification metric family (Slice 7). The HTTP routes for this family are deferred: exposing them needs the statistics-catalog S-n ids, the OpenAPI paths and the API-catalogue section in one commit (docs/backend/observability.md).",
  "tags": [
    "aveline",
    "notifications",
    "operator"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "FCM credentials configured",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "aveline_notification_fcm_credential_configured",
          "legendFormat": "configured",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "0 means push is a silent no-op: the logging fallback channel is selected and no recipient will ever receive a device push. This is the visible half of Slice 7.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inbox backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "aveline_notification_inbox_backlog",
          "legendFormat": "unread, undismissed",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Work items a user has not acted upon. NOT S-36's notification_backlog, which counts delivery rows with Status = Pending; the two must never be merged.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Delivery success rate by channel",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
