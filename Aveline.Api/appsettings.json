{
  "App": {
    "MobileScheme": "aveline"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Invitations": {
    "AcceptRateLimit": 10
  },
  "Firebase": {
    "ProjectId": "aveline-e35a5"
  },
  "Pricing": {
    "//": "Escape hatch: true reproduces the legacy ceil-to-1dp formula and ignores rules.",
    "UseLegacyFormula": true,
    "RuleCacheTtlSeconds": 5
  },
  "Eventing": {
    "SubscribeEventTypes": [
      "message.created",
      "message.updated",
      "conversation.created",
      "agent.status"
    ],
    "MetricsLogIntervalSeconds": 30
  },
  "AgentStats": {
    "MinSampleForPercentile": 20,
    "MaxStepsPerRun": 200
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
