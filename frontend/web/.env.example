VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
VITE_API_BASE_URL=http://localhost:5091

# Grafana deep links.
#
# Empty means: a development build points at the compose-published port
# (http://localhost:3000, marked "DEV ONLY" in docker-compose.yml) and a production build renders
# every link disabled, because no production route exists in this repository.
#
# Set both explicitly for a deployment, or to point a dev build at a different host:
#   VITE_GRAFANA_ENABLED=true
#   VITE_GRAFANA_BASE_URL=https://grafana.example.internal
#
# `VITE_GRAFANA_ENABLED=false` turns the links off everywhere, including development.
VITE_GRAFANA_ENABLED=
VITE_GRAFANA_BASE_URL=
