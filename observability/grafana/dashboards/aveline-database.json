      "type": "timeseries",
      "title": "Backends by state",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
