# =============================================================================
# Aveline — .gitignore
# Covers: .NET / ASP.NET Core, Python, Flutter/Dart, Node/JS, OS, IDEs, Secrets
# =============================================================================

# =============================================================================
# SECRETS & ENVIRONMENT FILES
# Never commit secrets. Only .env.example files are committed.
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
*secret*
# The Prometheus scrape-token directory must be tracked (empty except .gitkeep) so
# `promtool check config` has a mount point in CI; the token itself stays ignored.
!observability/prometheus/secrets/
observability/prometheus/secrets/*
!observability/prometheus/secrets/.gitkeep
# Local password file mounted into postgres-exporter (Slice 6).
postgres-exporter-password

# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encdata
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# IDEs & EDITORS
# =============================================================================

# JetBrains (Rider, IntelliJ, Android Studio)
.idea/
*.iml
*.iws
*.ipr

# Visual Studio / VS Code
.vs/
.vscode/settings.json
.vscode/launch.json
.vscode/.ropeproject
*.suo
*.user
*.userosscache
*.sln.docstates

# Keep shared VS Code config (extensions, tasks)
!.vscode/extensions.json
!.vscode/tasks.json

# =============================================================================
# .NET / ASP.NET CORE
# =============================================================================

# Build outputs
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Bb]in/
[Oo]bj/
bld/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Logs
# Anchored to the repo root on purpose. The unanchored Visual Studio template
# patterns also matched `src/**/logs/`, so they silently swallowed
# `frontend/web/src/components/admin/logs/` — source files that existed only on
# the machine that wrote them and broke every clean clone (CI, Vercel).
# `frontend/web/src/test/ignored-source.test.ts` guards against a recurrence.
/log/
/logs/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json

# Publishing
[Pp]ublish/
PublishScripts/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
nunit-*.xml
*.VisualState.xml
CodeCoverage/

# MSBuild
*.binlog
ScaffoldingReadMe.txt

# Misc
.dotnet/
~$*


# =============================================================================
# PYTHON
# =============================================================================

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
.tox/
.nox/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# Playwright (tests/e2e, run from frontend/web): per-run traces, screenshots and videos, and the
# HTML report. The browsers themselves live in node_modules/.playwright-browsers, already ignored.
test-results/
playwright-report/
blob-report/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Ruff / linting
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# =============================================================================
# FLUTTER / DART
# =============================================================================

# Build
build/

# Dart tool generated
.dart_tool/
.packages

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart

# Flutter plugin registration
.flutter-plugins
.flutter-plugins-dependencies

# Android
frontend/aveline_mobile/android/.gradle/
# Kotlin compiler session/cache dir, written by Gradle builds like .gradle/ above.
frontend/aveline_mobile/android/.kotlin/
frontend/aveline_mobile/android/captures/
frontend/aveline_mobile/android/local.properties
frontend/aveline_mobile/android/key.properties
frontend/aveline_mobile/android/app/*.jks
frontend/aveline_mobile/android/app/google-services.json

# JVM heap dumps — written by the JVM (and by Gradle's daemon) on OutOfMemoryError.
# These run to hundreds of megabytes and must never enter git history.
*.hprof
*.hprof.gz

# iOS
frontend/aveline_mobile/ios/Pods/
frontend/aveline_mobile/ios/.symlinks/
frontend/aveline_mobile/ios/Flutter/flutter_export_environment.sh
frontend/aveline_mobile/ios/GoogleService-Info.plist

# =============================================================================
# NODE / JAVASCRIPT (Husky + future web frontend)
# =============================================================================

node_modules/
.npm
.yarn/
*.tsbuildinfo

# Package manager lockfiles — Only bun lockfiles are committed
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml
pnpm-lock.yml

!bun.lock
!bun.lockb
!**/bun.lock
!**/bun.lockb

# Build outputs (web)
.next/
.nuxt/
.svelte-kit/
dist/
out/

# Caches
.eslintcache
.stylelintcache
.parcel-cache/

# =============================================================================
# DOCKER
# =============================================================================
# docker-compose.yml and Dockerfiles ARE committed.
# Only exclude local override files:
docker-compose.override.yml
docker-compose.local.yml

# =============================================================================
# MISC
# =============================================================================

# Coverage reports
coverage/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.ignore.*

# Agent Information
.agents/skills/
.claude/
USER_INFORMATION_FOR_AGENT.md

# Firebase service account key (never commit)
firebase-service-account.json

# docs
docs/.obsidian

# Agents.md
Agents.md
admin-backend-api-deferred-implementation-plan.md

# Backend cache
backend/.cache

# Stray nested clone of this repository (was accidentally committed as a gitlink)
/aveline/

opencode.json
# Final academic documentation (presented at evaluation, kept untracked)
docs/final_document/

# DSH harness tool cache: downloaded binaries (e.g. a 172 MB Flutter engine JAR), never project source.
.dsh-tools/

# =============================================================================
# AGENT SCRATCH & TOOLING — local only, never tracked
# The plans themselves stay untracked; these subpaths are pure scratch (agent
# worklogs, Obsidian state, generated issue bodies) and downloaded binaries.
# =============================================================================
.agents/plans/.work/
.agents/plans/.obsidian/
.agents/plans/*
.dsh-tools/
.research-shots/
.screenshots/

# The local Vercel project link, and every real environment file. `.env.example` stays tracked
# because tracked files are unaffected by these patterns.
.vercel/
.env*

# =============================================================================
# DEPLOYMENT-ORCHESTRATION SCRATCH — credentials and CLI caches, never tracked
# `.azcfg/` holds the Azure CLI token cache and `.vhome/` the Vercel CLI token
# cache, both relocated here because the sandbox home is read-only. Committing
# either would leak a live credential.
# =============================================================================
.azcfg/
.vhome/
.vercel-cache/
