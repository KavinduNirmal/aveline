# =============================================================================
# Aveline.Api — Backend configuration
# Copy to `.env` and fill in real values before running the API.
# =============================================================================

# --- Database & cache (local docker-compose defaults) ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aveline;Username=aveline;Password=change-me
Redis__ConnectionString=localhost:6379

# --- Auth (Clerk) ---
# Values are NOT committed. Generate them with `clerk env pull` (writes .env.local)
# or from the Clerk Dashboard: API Keys.
# Secret key used by the backend to verify Clerk JWTs (server-side only, never expose).
# CLERK_SECRET_KEY=
# Publishable key used by the Flutter / React clients (safe for client code).
# CLERK_PUBLISHABLE_KEY=
# Issuer / Frontend API base for the Aveline instance (from the publishable key).
# CLERK_ISSUER=https://inspired-warthog-8208.clerk.accounts.dev
# JSON Web Key Set endpoint for JWT signature validation (used by JwtBearer in #14).
# CLERK_JWKS_URL=https://inspired-warthog-8208.clerk.accounts.dev/.well-known/jwks.json
# Session JWT template (see Clerk Dashboard -> JWT Templates). Claims:
#   user_role  = {{user.public_metadata.role}}   (Aveline team-level role)
#   org_role   = {{org.role}}                    (per-store owner/staff role)
#   org_id / org_slug = {{org.id}} / {{org.slug}}
# CLERK_JWT_TEMPLATE=jwt-aveline-v1
# Allowed origin for the Vite admin dashboard (Clerk instance setting).
# CLERK_ALLOWED_ORIGIN=http://localhost:5173
# Backend JwtBearer authority (read by Program.cs via config "Clerk:Authority";
# default set in appsettings.Development.json). Override with the env var below.
# Clerk__Authority=https://inspired-warthog-8208.clerk.accounts.dev

# --- Internal agent service (service-to-service auth) ---
# Base URL of the Python agent service. In docker-compose use http://agent:8000.
# AgentService__BaseUrl=http://localhost:8000
# Shared secret sent as "X-Internal-Token" to the agent service. Must match the
# agent's INTERNAL_API_TOKEN. Override with a strong value in production.
# AgentService__InternalToken=aveline-local-development-secret-token-2026

# --- Telemetry privacy ---
# Salt for the SHA-256 hashes of client IP addresses and user agents stored by request
# telemetry. Required in Production (the API refuses to start without it, M-1).
# Telemetry__IpHashSalt=

# --- Integrations (configure when implemented) ---
# WhatsApp Business Cloud API access token.
# WhatsApp__ApiToken=
# WhatsApp sender phone number ID.
# WhatsApp__PhoneNumberId=
# Token used to validate inbound webhook signatures.
# WhatsApp__WebhookVerifyToken=
# Payment gateway (PayHere / Stripe) base URL.
# PaymentGateway__BaseUrl=
# Payment gateway API key.
# PaymentGateway__ApiKey=

# --- Payments: the external OnePay adapter (plan Phase 8, Q5) ---
# Select the adapter. `manual` (the default) is the honest representation of today: an operator
# confirms receipt out of band. `mock` is Development-only. `onepay` needs the two keys below.
# Payments__Provider=manual
#
# The App ID from the OnePay merchant dashboard. Required when Provider=onepay; the API refuses to
# start without it.
# Payments__OnePay__AppId=
# The HASH_SALT that signs every request as SHA256(app_id + currency + amount + HASH_SALT).
# A SECRET: keep it in the deployment's secret store, never in a committed file or a client bundle.
# Required when Provider=onepay; the API refuses to start without it.
# Payments__OnePay__HashSalt=
# The App Token the refund endpoint's Authorization header carries. A SECRET; only needed to refund.
# Payments__OnePay__AppToken=
# OnePay API origin. Defaults to the published live base URL; point it at the sandbox to test.
# Payments__OnePay__BaseUrl=https://api.onepay.lk
# The customer fields the redirection request requires. Deployment-level values, because the SPI
# carries an organisation reference rather than a person; the OnePay-hosted page confirms the payer.
# Payments__OnePay__CustomerDefaults__FirstName=
# Payments__OnePay__CustomerDefaults__LastName=
# Payments__OnePay__CustomerDefaults__PhoneNumber=
# Payments__OnePay__CustomerDefaults__Email=

# Courier / delivery provider base URL.
# Courier__BaseUrl=
# Courier provider API key.
# Courier__ApiKey=
