#!/usr/bin/env sh
# =============================================================================
# Aveline — Husky Pre-commit Hook
#
# Runs quality gates before every commit. Checks are intentionally fast.
# If a check fails, the commit is blocked with a clear error message.
# =============================================================================

set -e

YELLOW=$(printf '\033[1;33m')
GREEN=$(printf '\033[0;32m')
RED=$(printf '\033[0;31m')
NC=$(printf '\033[0m') # No Color

echo ""
echo "${YELLOW}🔍 Running Aveline pre-commit checks...${NC}"
echo ""

# ---------------------------------------------------------------------------
# 1. GUARD: No .env files committed
# ---------------------------------------------------------------------------
echo "  [1/6] Checking for .env files in staged changes..."

STAGED_ENV=$(git diff --cached --name-only | grep -E '\.env$|\.env\.' | grep -v '\.env\.example' || true)

if [ -n "$STAGED_ENV" ]; then
  echo ""
  echo "${RED}  ❌ BLOCKED: You are trying to commit a .env file:${NC}"
  echo "$STAGED_ENV"
  echo "${RED}  Remove these files from staging with: git restore --staged <file>${NC}"
  echo ""
  exit 1
fi

echo "  ${GREEN}✓ No .env files staged${NC}"

# ---------------------------------------------------------------------------
# 2. GUARD: Only bun lockfiles allowed (block npm, yarn, pnpm lockfiles)
# ---------------------------------------------------------------------------
echo "  [2/6] Checking for non-bun lockfiles in staged changes..."

STAGED_NON_BUN_LOCKS=$(git diff --cached --name-only | grep -E '(package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.ya?ml)$' || true)

if [ -n "$STAGED_NON_BUN_LOCKS" ]; then
  echo ""
  echo "${RED}  ❌ BLOCKED: Only bun lockfiles (bun.lock / bun.lockb) are published to this repository.${NC}"
  echo "${RED}  Found non-bun lockfile(s) staged for commit:${NC}"
  echo "$STAGED_NON_BUN_LOCKS"
  echo "${RED}  Please use bun (or bun install) and remove other lockfiles with: git restore --staged <file>${NC}"
  echo ""
  exit 1
fi

echo "  ${GREEN}✓ Only bun lockfiles staged${NC}"

# ---------------------------------------------------------------------------
# 3. GUARD: No obvious secrets in staged files
# Patterns: 'password =', 'api_key =', 'secret =', 'token =' etc.
# ---------------------------------------------------------------------------
echo "  [3/6] Scanning staged files for potential secrets..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

SECRET_FOUND=""
for file in $STAGED_FILES; do
  # Skip binary files and known safe files
  case "$file" in
    *.png|*.jpg|*.gif|*.pdf|*.zip|*.lock|*.gitignore) continue ;;
  esac
  if git show ":$file" 2>/dev/null | grep -qiE '(password|api_key|secret|private_key|access_token)\s*[=:]\s*["\x27][^"\x27]{8,}'; then
    SECRET_FOUND="$SECRET_FOUND $file"
  fi
done

if [ -n "$SECRET_FOUND" ]; then
  echo ""
  echo "${RED}  ❌ BLOCKED: Potential secrets detected in:${NC}"
  echo "$SECRET_FOUND"
  echo "${RED}  Review these files. Use environment variables instead of hardcoded secrets.${NC}"
  echo "${RED}  If this is a false positive, use: git commit --no-verify${NC}"
  echo ""
  exit 1
fi

echo "  ${GREEN}✓ No obvious secrets found${NC}"

# ---------------------------------------------------------------------------
# 4. ASP.NET Core API — dotnet build
# ---------------------------------------------------------------------------
echo "  [4/6] Building ASP.NET Core API..."

if command -v dotnet &> /dev/null; then
  if dotnet build Aveline.Api/Aveline.Api.csproj --no-restore -c Debug -v quiet 2>&1; then
    echo "  ${GREEN}✓ dotnet build passed${NC}"
  else
    echo ""
    echo "${RED}  ❌ dotnet build failed. Fix build errors before committing.${NC}"
    echo ""
    exit 1
  fi
else
  echo "  ${YELLOW}⚠ dotnet not found — skipping API build check${NC}"
fi

# ---------------------------------------------------------------------------
# 5. Python — syntax check on staged .py files
# ---------------------------------------------------------------------------
echo "  [5/6] Checking Python syntax on staged .py files..."

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -n "$STAGED_PY" ]; then
  if command -v python3 &> /dev/null; then
    PYTHON_ERRORS=""
    for pyfile in $STAGED_PY; do
      if ! python3 -m py_compile "$pyfile" 2>/dev/null; then
        PYTHON_ERRORS="$PYTHON_ERRORS $pyfile"
      fi
    done
    if [ -n "$PYTHON_ERRORS" ]; then
      echo ""
      echo "${RED}  ❌ Python syntax errors in:${NC}"
      echo "$PYTHON_ERRORS"
      echo ""
      exit 1
    fi
    echo "  ${GREEN}✓ Python syntax OK${NC}"
  else
    echo "  ${YELLOW}⚠ python3 not found — skipping Python syntax check${NC}"
  fi
else
  echo "  ${GREEN}✓ No .py files staged${NC}"
fi

# ---------------------------------------------------------------------------
# 6. Flutter — analyze on staged .dart files
# ---------------------------------------------------------------------------
echo "  [6/6] Checking staged .dart files..."

STAGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)

if [ -n "$STAGED_DART" ]; then
  if command -v flutter &> /dev/null; then
    if flutter analyze frontend/aveline_mobile --no-fatal-infos 2>&1 | grep -q 'No issues found'; then
      echo "  ${GREEN}✓ Flutter analyze passed${NC}"
    else
      echo ""
      echo "${YELLOW}  ⚠ Flutter analyze reported issues. Run 'flutter analyze' to review.${NC}"
      echo "  ${YELLOW}  Commit is not blocked — but please fix warnings before merging to main.${NC}"
      echo ""
    fi
  else
    echo "  ${YELLOW}⚠ flutter not found — skipping Flutter analyze${NC}"
  fi
else
  echo "  ${GREEN}✓ No .dart files staged${NC}"
fi

# ---------------------------------------------------------------------------
# All checks passed
# ---------------------------------------------------------------------------
echo ""
echo "${GREEN}  ✅ All pre-commit checks passed. Proceeding with commit.${NC}"
echo ""
