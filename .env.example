# =============================================================================
# Aveline — Local Infrastructure (used by docker-compose.yml)
# Copy to `.env` and fill in real values before running `docker compose up`.
# =============================================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=aveline
POSTGRES_USER=aveline
# REQUIRED: docker-compose fails to start postgres without this.
POSTGRES_PASSWORD=change-me
# Host port published on the machine (development only; PostgreSQL listens on 5432 inside).
POSTGRES_PORT=5433
# Compose-network hostname and port the containers use to reach PostgreSQL. The image listens on
# 5432, so change POSTGRES_INTERNAL_PORT only together with the service's own listen config.
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
# libpq sslmode appended to the postgres_exporter DSN. `disable` is correct inside the network.
POSTGRES_SSLMODE=disable

# --- Redis ---
# Host port published on the machine (development only; Redis listens on 6379 inside).
REDIS_PORT=6379
# Compose-network hostname and port the containers use to reach Redis (image default 6379).
REDIS_HOST=redis
REDIS_INTERNAL_PORT=6379

# --- Redis Pub/Sub event bus (ADR-014) ---
# Event types the agent service consumes from the API (comma-separated).
#   message.received  - inbound WhatsApp message (agent reacts)
SUBSCRIBE_EVENT_TYPES=message.received
# Event types the API consumes from the agent service (indexed env var form).
#   message.created / message.updated / conversation.created - Salon content events
#   agent.status - agent lifecycle states (the API broadcasts them over SignalR)
EVENTING_SUBSCRIBE_EVENT_TYPES_0=message.created
EVENTING_SUBSCRIBE_EVENT_TYPES_1=message.updated
EVENTING_SUBSCRIBE_EVENT_TYPES_2=conversation.created
EVENTING_SUBSCRIBE_EVENT_TYPES_3=agent.status

# --- Service host ports ---
# API host port 5091 matches the web client default (VITE_API_BASE_URL) and `dotnet run`.
API_PORT=5091
# The agent is intentionally never published to the host (S-2): it is reachable only inside the
# compose network, on AGENT_INTERNAL_PORT below.

# --- Compose network wiring (in-network hostnames and ports) ---
# How the containers address each other inside the compose network. The defaults are the compose
# service names, so the stack runs unchanged when these are unset. The API and agent bind the port
# they are given here; PostgreSQL, Redis and the collector listen on their image/config port.
API_HOST=api
API_INTERNAL_PORT=8080
AGENT_HOST=agent
AGENT_INTERNAL_PORT=8000
OTEL_COLLECTOR_HOST=otel-collector
# Must match the OTLP/HTTP receiver endpoint in otel-collector-config.yaml (0.0.0.0:4318).
OTEL_COLLECTOR_PORT=4318

# --- ASP.NET Core runtime ---
# Environment name the API boots in. Development loads appsettings.Development.json (and is
# required for the local Clerk/internal-token defaults); Production refuses to boot without
# Telemetry__IpHashSalt.
API_ENVIRONMENT=Development

# --- Internal service-to-service auth ---
# Shared secret between Aveline.Api and the agent service (X-Internal-Token header).
# Both services reject the old "change-me-internal-token" placeholder, so the local
# default below is a dev-only value they accept; set a high-entropy secret when deploying.
INTERNAL_API_TOKEN=aveline-local-development-secret-token-2026

# --- Telemetry privacy ---
# Salt for the SHA-256 hashes of client IP addresses and user agents stored by request
# telemetry. The API refuses to start in Production without it (M-1); set a high-entropy
# secret there. The development default below satisfies the compose profile.
TELEMETRY_IP_HASH_SALT=local-development-telemetry-salt

# --- Agent service LLM provider (openai | deepseek) ---
# Switched at runtime via LLM_PROVIDER. LLM_API_KEY is required to run real
# agent workflows; LLM_BASE_URL/LLM_MODEL override provider defaults.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# When false, reasoner-capable DeepSeek models are asked to skip the thinking pass.
LLM_THINKING_ENABLED=false
# Master switch for invoking an LLM in agent workflows (requires LLM_API_KEY + LLM_MODEL too).
AGENT_LLM_ENABLED=true
# Artificial delay (ms) between emitted agent states so clients can visibly animate
# Aveline's blossom through each state during integration testing. 0 disables it.
AGENT_STATE_DELAY_MS=0

# --- Agent service observability (OpenTelemetry) ---
# Traces are exported to the otel-collector and visualized in Jaeger
# (http://localhost:16686). Set OTEL_TRACE_CONTENT=false in production to strip
# prompt/completion content from exported spans.
# The agent *container* endpoint is derived from OTEL_COLLECTOR_HOST/PORT above; this key is for
# running the agent on the host (`uvicorn`), where the collector is published on localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Resource attribute identifying this service in traces and metrics.
OTEL_SERVICE_NAME=aveline-agent-service
OTEL_TRACE_CONTENT=true

# --- Aveline.Api tenant-credential encryption ---
# REQUIRED: base64-encoded 32-byte key used to AES-256-GCM encrypt boutique
# integration credentials (WhatsApp/Instagram/payment). Generate with:
#   openssl rand -base64 32
# Rotate carefully — credentials encrypted with the previous key cannot be decrypted.
CREDENTIALS_ENCRYPTION_KEY=change-me-base64-32-byte-key

# --- Public app base URL ---
# Used to build shareable staff-invitation links (e.g. https://app.aveline.lk or
# http://localhost:5173 for local web development).
APP_BASE_URL=http://localhost:5173

# --- WhatsApp (Meta) integration gateway ---
# Meta Graph API ROOT only. The provider appends "/{phoneNumberId}" and
# "/{phoneNumberId}/messages" itself, so do NOT include a version, phone number id, or path
# here. Setting it to a full message-send URL (e.g.
# https://graph.facebook.com/v25.0/<phoneNumberId>/messages) produced
# "Unknown path components: /v21.0/<phoneNumberId>" from Meta and left the integration in
# the Error state.
#
# NOTE ON PRECEDENCE: docker compose reads a real environment variable in preference to this
# file. If WHATSAPP_BASE_URL (or any value here) is exported in your shell, the shell wins
# silently — `docker compose config` will show the effective value. Check it with:
#   docker compose config | grep -A2 WhatsApp__BaseUrl
# Override for a single run with:
#   WHATSAPP_BASE_URL=https://graph.facebook.com docker compose up -d --force-recreate api
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# --- Integration health service ---
# How often (hours) the background service validates connected integrations for token expiry.
INTEGRATION_HEALTH_INTERVAL_HOURS=6

# --- Webhook guardrails ---
# Optional comma-separated allow-list of IPs that may POST to the public WhatsApp webhook
# (Meta publishes its webhook IP ranges). Leave empty to allow any IP (HMAC still enforced).
WEBHOOK_ALLOWED_IPS=

# --- Firebase Cloud Messaging (push notifications) ---
# Optional. When unset, the API falls back to a logging push channel so it runs without
# Firebase credentials. Set both to enable real FCM push delivery.
# Project id (also set in Aveline.Api/appsettings.json).
FIREBASE_PROJECT_ID=aveline-e35a5
# The API reads the service-account key from ./firebase-service-account.json (gitignored),
# mounted into the api container. Generate it in the Firebase console:
#   Project settings > Service accounts > Generate new private key
# For local `dotnet run`, set the env var instead:
#   Firebase__CredentialsPath=/absolute/path/to/firebase-service-account.json

# --- Customer Memory embeddings (OpenAI-compatible) ---
# Used by the API EmbeddingService for pgvector memory retrieval (Ava / Customer Memory agent).
# BaseUrl/Model default to OpenAI text-embedding-3-small when unset.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Visual Intelligence Vision Provider (OpenAI-compatible, multimodal) ---
# Used by the API VisionService for multimodal image attribute extraction (Elle / Visual Insight agent).
# BaseUrl/Model must point at a multimodal OpenAI-compatible endpoint, and Model must be an id that
# actually exists for that provider: a retired id answers 404. The local verified-working shape is
# DeepSeek (VISION_BASE_URL=https://api.deepseek.com with a DeepSeek model and key).
#
# REQUIRED for real image analysis. This is a *vision* credential and is deliberately NOT the
# agent service's LLM_API_KEY: it is paired with the BaseUrl below, so a text-only endpoint would
# fail every upload and silently degrade to VisionService's deterministic fallback, which derives a
# colour from the FILE NAME rather than from the photograph. Leave this empty only if that
# fallback is what you want.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com
VISION_MODEL=gpt-4o-mini

# --- Cloudinary media provider (strategy §3.4) ---
# REQUIRED only when Media:Provider=cloudinary. The API resolves the credential once at
# startup and never reads the SDK's ambient global. The primary form is CLOUDINARY_URL
# (cloudinary://<key>:<secret>@<cloud_name>); the discrete pair below is the fallback and
# must be set together. Inject these names from the deployment secret store — never put a
# real key in this file, and never leave a sample URL carrying a plausible-looking key.
# These are the four names docker-compose.yml passes through to the api container.
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The cloud name for the discrete fallback (not a secret; also carried by CLOUDINARY_URL).
CLOUDINARY_CLOUD_NAME=

# --- Media storage and delivery (strategy §3.4) ---
# The API binds these as `Media:*`; a deployment sets the same names with `__` for `:`.
# docker-compose.yml passes every `Media__*` key below through to the API container under these
# exact names, falling back to the `Aveline.Api/appsettings.json` default (backed by
# MediaOptions.cs) when the value is unset. The values shown are those safe defaults: bytes stay in
# the database and every optional capability is off. A malformed value is a startup refusal, not a
# first-request error (MediaOptionsValidator.ValidateOrThrow).
#
# Media__Provider is the switch that moves NEW catalog and attachment bytes to Cloudinary
# (`cloudinary`) instead of the Postgres row (`database`). Media__Provider=cloudinary needs a
# complete Cloudinary credential — either CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
# or the discrete CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET + CLOUDINARY_CLOUD_NAME triple — and
# MediaOptionsValidator refuses the boot when it cannot resolve one.
Media__Provider=database
# The protected read path's per-row dispatch: honour a Cloudinary reference on a row that carries
# one. `false` falls back to the row's bytes.
Media__ReadFromCloudinary=false
# Also keep the bytes on the row when a provider write happens (the second copy that makes
# Media__Provider=database free to fall back to).
Media__DualWrite=false
# Media token signing. REQUIRED when Media__Provider=cloudinary: MediaOptionsValidator refuses a
# blank, non-base64 or wrong-length value. base64, exactly 32 bytes (`openssl rand -base64 32`).
# Rotating it invalidates every outstanding media token. The vision reference arm no longer mints
# a token (it hands the provider the stored bytes inline), so this is not required for image
# analysis by reference.
#
# docker-compose interpolates MEDIA_SIGNING_KEY / MEDIA_PUBLIC_BASE_URL and maps them into the API
# container as Media__SigningKey / Media__PublicBaseUrl.
MEDIA_SIGNING_KEY=
# The absolute origin the minted media-token URLs handed to external fetchers are built from. Set
# it to an origin the *caller* can reach: the agent service is inside the compose network, so
# `http://api:8080` is correct there, while `http://localhost:5091` is only right for a process
# running on the host. Must be an absolute http(s) URL.
MEDIA_PUBLIC_BASE_URL=
Media__AllowDatabaseProviderInProduction=false
Media__VisionTokenTtlSeconds=600
Media__AttachmentTokenTtlSeconds=900
Media__ClockSkewToleranceSeconds=30
Media__VisionUsePrivateDownload=false
# The pasted-image-URL fetcher's kill switch. Leave false; if you enable it, set the allow-list too.
Media__ImageUrlUploadEnabled=false
Media__ImageUrlAllowlist=
Media__ImageUrlMaxRedirects=2
Media__ImageUrlFetchTimeoutSeconds=10
Media__AllowInsecureImageFetch=false
# The catalog tier's own cap, tighter than the 5 MB attachment cap.
Media__CatalogMaxFileBytes=2097152
# Exactly one delivery width. Do not add a second: f_auto derives a format per width.
Media__CatalogDisplayWidth=800

# --- Conversation attachment retention (S7) ---
# A bound conversation attachment older than this window is deleted, releasing the remote asset
# before the row disappears. Set it high (or stop the job) to roll the policy back.
Conversations__AttachmentRetentionDays=7
# Bounded per run, following CustomerSalonBackfill; a backlog drains across runs.
Conversations__AttachmentRetentionMaxPerRun=500


# --- Observability: Prometheus + Grafana (metrics plan Slices 1, 3, 6) ---
# docker compose declares all three of these with `:?`, so an unset or empty value FAILS THE
# STACK rather than silently falling back to the committed internal service token (S-1/R-1).
# Generate each with:  openssl rand -hex 32
#
# After setting them, run  ./scripts/sync_observability_secrets.sh  to write the two companion
# files the containers mount:
#   * observability/prometheus/secrets/scrape_token  <- METRICS_SCRAPE_TOKEN
#       Prometheus reads this via `authorization.credentials_file`, and `promtool check config`
#       stats it, so the file must exist even for a config-only validation.
#   * ./postgres-exporter-password                   <- POSTGRES_EXPORTER_PASSWORD
#       mounted as DATA_SOURCE_PASS_FILE; the database role is created from the same value by
#       observability/postgres-exporter/init-role.sh on first database initialisation.
METRICS_SCRAPE_TOKEN=
GRAFANA_ADMIN_PASSWORD=
POSTGRES_EXPORTER_PASSWORD=
POSTGRES_EXPORTER_USER=postgres_exporter
# Prometheus and Grafana are also reachable inside the compose network at
# http://prometheus:9090 and http://grafana:3000. These ports are DEV ONLY (S-2).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Published host ports for the OTLP HTTP receiver and the Jaeger UI / OTLP gRPC receiver. The
# containers listen on 4318 / 16686 / 4317; only the host side is configurable here. DEV ONLY.
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317

# --- Grafana lock-down flags ---
# Overridable, but the secure defaults must stay: no anonymous access, no self-signup and no
# embedding (the console is out of scope and does not embed Grafana, D3).
GRAFANA_ANONYMOUS_ENABLED=false
GRAFANA_ALLOW_SIGN_UP=false
GRAFANA_ALLOW_EMBEDDING=false
