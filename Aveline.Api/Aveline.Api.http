@Aveline.Api_HostAddress = http://localhost:5091

GET {{Aveline.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Requires a valid Clerk JWT (jwt-aveline-v1 template). Without a token this returns 401.
GET {{Aveline.Api_HostAddress}}/api/auth/claims
Authorization: Bearer {{clerk_token}}

###
