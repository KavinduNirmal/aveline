# =============================================================================
# Aveline — Local Infrastructure (used by docker-compose.yml)
# Copy to `.env` and fill in real values before running `docker compose up`.
# =============================================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=aveline
POSTGRES_USER=aveline
# REQUIRED: docker-compose fails to start postgres without this.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Service host ports ---
API_PORT=5000
AGENT_PORT=8000

# --- Internal service-to-service auth ---
# Shared secret between Aveline.Api and the agent service (X-Internal-Token header).
INTERNAL_API_TOKEN=change-me-internal-token
