    {
      "id": 1,
      "type": "stat",
      "title": "API /metrics scrape",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "max(up{job=\"aveline-api\"})",
          "legendFormat": "API /metrics scrape",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "1 = Prometheus can authenticate and scrape the API. 0 fires AvelineApiScrapeDown."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bridge freshness",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": [],
          "noValue": "-",
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "time() - max(timestamp(aveline_process_cpu_seconds_total))",
          "legendFormat": "Bridge freshness",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Seconds since the collector last published a bridged business metric. This is the panel that distinguishes 'the value is 0' from 'the bridge stopped': the gauges are only written when a value exists, so a stalled collector looks like a gap, not a zero."
    },
