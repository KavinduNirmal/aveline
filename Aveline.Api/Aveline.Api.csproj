<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Aveline.Api.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pinned exactly. The SDK is not vendor-supported on net10.0 and drags in
             Newtonsoft.Json; risk R17's mitigation is this pin plus the four-operation live
             smoke suite (CloudinaryLiveSmokeTests), not an assumption. The one package this
             wave adds. -->
        <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
        <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <!-- 10.0.11+ pulls the patched Microsoft.OpenApi (>= 2.7.5), closing GHSA-v5pm-xwqc-g5wc. -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
        <!-- Explicit reference so the event bus can use IConnectionMultiplexer/ISubscriber directly
             (already a transitive dependency of Microsoft.Extensions.Caching.StackExchangeRedis). -->
        <PackageReference Include="StackExchange.Redis" Version="2.7.27" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="QRCoder" Version="1.6.0" />
        <!-- The first-contact disclosure carries a composed image, so the API rasterises it.
             SkiaSharp is MIT. The NoDependencies native build is the one that does not need
             fontconfig: the runtime image is noble-chiseled with no shell and no font packages,
             and the fonts are embedded here rather than loaded from the system. ImageSharp was
             the other candidate and was rejected for its split licence, which is a commercial-use
             question this project should not be taking on for a decorative image. -->
        <PackageReference Include="SkiaSharp" Version="4.152.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
        <PackageReference Include="ZXing.Net" Version="0.16.10" />
    </ItemGroup>

    <ItemGroup>
        <!-- The brand faces ship inside the assembly. A path relative to the repo would work on a
             developer machine and fail in the container, and the failure mode is a disclosure image
             with no text on it. LogicalName is set explicitly because MSBuild's default resource
             naming is easy to get subtly wrong and impossible to notice until a font fails to load.
             The OFL licences travel with them, as both fonts require. -->
        <EmbeddedResource Include="Assets/Fonts/PlayfairDisplay-SemiBold.ttf"
                          LogicalName="Aveline.Api.Fonts.PlayfairDisplay-SemiBold.ttf" />
        <EmbeddedResource Include="Assets/Fonts/DMSans-SemiBold.ttf"
                          LogicalName="Aveline.Api.Fonts.DMSans-SemiBold.ttf" />
        <EmbeddedResource Include="Assets/Fonts/DMSans-Regular.ttf"
                          LogicalName="Aveline.Api.Fonts.DMSans-Regular.ttf" />
        <None Include="Assets/Fonts/OFL-PlayfairDisplay.txt" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Assets/Fonts/OFL-DMSans.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
