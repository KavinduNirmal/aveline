# =============================================================================
# Aveline — Local Infrastructure (used by docker-compose.yml)
# Copy to `.env` and fill in real values before running `docker compose up`.
# =============================================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=aveline
POSTGRES_USER=aveline
# REQUIRED: docker-compose fails to start postgres without this.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Service host ports ---
API_PORT=5091
AGENT_PORT=8000

# --- Internal service-to-service auth ---
# Shared secret between Aveline.Api and the agent service (X-Internal-Token header).
INTERNAL_API_TOKEN=change-me-internal-token

# --- Aveline.Api tenant-credential encryption ---
# REQUIRED: base64-encoded 32-byte key used to AES-256-GCM encrypt boutique
# integration credentials (WhatsApp/Instagram/payment). Generate with:
#   openssl rand -base64 32
# Rotate carefully — credentials encrypted with the previous key cannot be decrypted.
CREDENTIALS_ENCRYPTION_KEY=YGmE7Yj+JOWyDVlRiwF2+jNTVFWQGBlSoHNDEf9GRM8=

# --- Public app base URL ---
# Used to build shareable staff-invitation links (e.g. https://app.aveline.lk or
# http://localhost:5173 for local web development).
APP_BASE_URL=http://localhost:5173

CLERK_PUBLISHABLE_KEY=pk_test_aW5zcGlyZWQtd2FydGhvZy04MjA4LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_YnvE7BJFRwe62LR3GFwex8lfMSHNRVyRlTyKHLeMMK
INTERNAL_API_TOKEN=av_77b925fab7b174ac27545fb84fe5b8f09279752a3814b75be13220fc0aeeba5f
