        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "aveline_notification_delivery_success_rate_ratio",
          "legendFormat": "{{channel}}",
          "range": true,
          "refId": "A"
        }
