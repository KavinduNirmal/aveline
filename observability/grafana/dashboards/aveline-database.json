            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "pg_database_size_bytes{datname=~\"$datname\"}",
          "legendFormat": "{{datname}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
