{
  "uid": "aveline-database",
  "title": "Aveline \u2014 Database (postgres_exporter)",
  "description": "Server-side pg_stat_* views that Npgsql cannot see: locks, buffer-cache hit ratio, database growth and backend counts. Per-request and per-query latency live on the System overview. The replication panel shows pg_replication_is_replica, never lag.",
  "tags": [
    "aveline",
    "database",
    "operator"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "aveline-prometheus"
        },
        "query": {
          "query": "label_values(pg_database_size_bytes{datname!~\"template.*\"}, datname)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "System overview",
      "type": "link",
      "url": "/d/aveline-overview",
      "icon": "external link"
    },
    {
      "title": "Business metrics",
      "type": "link",
      "url": "/d/aveline-business",
      "icon": "external link"
    },
    {
      "title": "Notifications",
      "type": "link",
      "url": "/d/aveline-notifications",
      "icon": "external link"
    },
    {
      "title": "Prometheus",
      "type": "link",
      "url": "http://localhost:9090",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Is this a replica?",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "pg_replication_is_replica",
          "legendFormat": "replica",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "The HONEST replication signal. pg_replication_lag_seconds is hardcoded 0 on a primary, so a lag panel would draw a healthy flat line for a deployment with no replica at all (R-23). This stack has one primary and no standby.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Locks held by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (mode) (pg_locks_count{datname=~\"$datname\"})",
          "legendFormat": "{{mode}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "All pg_locks rows; there is no 'waiting locks' metric. Mode values are lowercased.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Deadlock rate",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(pg_stat_database_deadlocks{datname=~\"$datname\"}[$__rate_interval]))",
          "legendFormat": "deadlocks/s",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Buffer-cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "no data",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "aveline-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) / clamp_min(sum by (datname) (rate(pg_stat_database_blks_hit{datname=~\"$datname\"}[$__rate_interval])) + sum by (datname) (rate(pg_stat_database_blks_read{datname=~\"$datname\"}[$__rate_interval])), 1)",
          "legendFormat": "{{datname}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "clamp_min(..., 1) is required: blks_read can be 0 in the window and the plain ratio is then NaN. Both operands are PostgreSQL counters.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Database size",
      "datasource": {
        "type": "prometheus",
        "uid": "aveline-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
